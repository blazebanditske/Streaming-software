{
  "name": "streaming-software",
  "version": "0.1.0",
  "private": true,
  "description": "Free, simple, open-source multistreaming studio. One capture, many RTMP destinations.",
  "license": "MIT",
  "type": "module",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "test": "node --test \"server/test/**/*.test.js\"",
    "desktop": "npm --prefix desktop start",
    "mobile:add": "npm --prefix mobile run add:android",
    "mobile:sync": "npm --prefix mobile run sync"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
