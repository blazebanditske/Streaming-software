{
  "name": "streaming-software-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the streaming-software studio.",
  "license": "MIT",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.streamingsoftware.studio",
    "productName": "Streaming Software",
    "files": ["main.js", "preload.js", "**/*"],
    "extraResources": [
      { "from": "../server", "to": "server" },
      { "from": "../web", "to": "web" },
      { "from": "node_modules/ws", "to": "node_modules/ws" }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.video" },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo" }
  }
}
